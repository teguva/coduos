[Unit]
Description=CoduOS dashboard
Documentation=https://github.com/teguva/coduos
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/coduosd --config /etc/coduos/coduos.toml
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
