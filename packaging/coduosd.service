[Unit]
Description=CoduOS dashboard
Documentation=https://github.com/teguva/coduos
# Bind is loopback (nginx in front). Do not wait for Docker or "network online"
# — either one can stall boot for minutes or skip the dashboard entirely.
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/coduosd --config /etc/coduos/coduos.toml
Restart=always
RestartSec=2
TimeoutStopSec=20
# No CAP_NET_ADMIN. WireGuard and nginx are reloaded via allowlisted units.

[Install]
WantedBy=multi-user.target
